{
  "manifestVersion": 1,
  "id": "video-understand",
  "name": "视频理解",
  "version": "0.1.0",
  "description": "自适应抽帧 + 语音转录，把视频变成可读的带时间戳描述。移植自 mai-video-adaptive。",
  "minAppVersion": "0.82.0",
  "activationEvents": ["onStartup"],
  "capabilities": ["resource.read", "resource.materialize", "network.fetch"],
  "network": {
    "allowedHosts": ["api.deepseek.com", "api.siliconflow.cn"],
    "methods": ["POST"],
    "defaultTimeoutMs": 240000,
    "maxResponseBytes": 33554432
  },
  "contributes": {
    "configuration": {
      "title": "视频理解",
      "properties": {
        "ffmpegPath": {
          "type": "string",
          "default": "",
          "description": "ffmpeg 可执行文件绝对路径。留空则用 PATH 里的 ffmpeg"
        },
        "ffprobePath": {
          "type": "string",
          "default": "",
          "description": "ffprobe 可执行文件绝对路径。留空则用 PATH 里的 ffprobe"
        },
        "visionApiUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/chat/completions",
          "description": "视觉模型接口地址（OpenAI 兼容）"
        },
        "visionApiKey": {
          "type": "string",
          "default": "",
          "description": "视觉模型 API Key"
        },
        "visionModel": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "视觉模型名称"
        },
        "asrMode": {
          "type": "string",
          "default": "api",
          "enum": ["off", "api"],
          "description": "语音转录模式：off 不读音频，api 走云端接口"
        },
        "asrApiUrl": {
          "type": "string",
          "default": "https://api.siliconflow.cn/v1/audio/transcriptions",
          "description": "语音转写接口地址"
        },
        "asrApiKey": {
          "type": "string",
          "default": "",
          "description": "语音转写 API Key"
        },
        "asrModel": {
          "type": "string",
          "default": "FunAudioLLM/SenseVoiceSmall",
          "description": "语音转写模型名称"
        },
        "minFrames": {
          "type": "integer",
          "default": 0,
          "description": "最少抽帧数，0 表示自适应"
        },
        "maxFrames": {
          "type": "integer",
          "default": 0,
          "description": "最多抽帧数，0 表示自适应（上限 48）"
        },
        "maxHeight": {
          "type": "integer",
          "default": 720,
          "description": "抽帧后的最大高度，等比缩小不放大"
        },
        "keepTimeline": {
          "type": "boolean",
          "default": true,
          "description": "把完整时间轴落盘到插件数据目录，方便之后追问细节"
        }
      }
    }
  }
}
